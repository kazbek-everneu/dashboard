# Database
DATABASE_URL=postgresql+asyncpg://qa:qa_secret@db:5432/qa_screenshots
POSTGRES_USER=qa
POSTGRES_PASSWORD=qa_secret
POSTGRES_DB=qa_screenshots

# Redis
REDIS_URL=redis://redis:6379

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# JWT
# ACCESS_TOKEN_EXPIRE_MINUTES is an initial default; override it at runtime in
# the web Global Settings (Security & Sessions). Cookie flags stay .env-only.
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours
ACCESS_TOKEN_COOKIE_NAME=access_token
ACCESS_TOKEN_COOKIE_SECURE=false
ACCESS_TOKEN_COOKIE_SAMESITE=lax
# Initial defaults; editable in Global Settings → Security & Sessions.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=3600

# CORS and artifact URLs
# CORS_ALLOWED_ORIGINS stays .env-only (read once at startup, needs a restart).
CORS_ALLOWED_ORIGINS=http://localhost:15173,http://127.0.0.1:15173
# FRONTEND_BASE_URL is an initial default; editable in Global Settings → Email.
FRONTEND_BASE_URL=http://localhost:15173

# SMTP password reset email
# Host/port/from/TLS are initial defaults; editable in Global Settings → Email.
# Credentials (SMTP_USERNAME / SMTP_PASSWORD) are secrets and stay .env-only.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true

# File storage
DATA_DIR=data

# Remote Playwright browser server (separate container/host).
# BASE HOST WITHOUT A PORT — the worker appends the per-browser port
# (chrome 3001, msedge 3002, firefox 3003, webkit 3004; 3000 is retired).
# The dev stack sets this to the in-network `browser` service automatically
# (compose.dev.yml, built from the sibling repo everneu-screenshots-browsers);
# in production deploy that repo on a separate host and point this at it,
# e.g. ws://10.0.0.5  (NOT ws://10.0.0.5:3001/).
# Empty = launch browsers locally (requires `python -m playwright install chrome`).
# The browser server's image version MUST match the playwright pip version.
BROWSER_WS_ENDPOINT=
# WebSocket path of the browser servers. Set the SAME value here and on the
# browser host (the browser container reads it as BROWSER_WS_PATH too). It is
# NOT a secret — each server answers `GET /json` with it — so the browser ports
# must stay on a private network. Empty = servers listen at "/".
BROWSER_WS_PATH=
# BROWSER_CONNECT_TIMEOUT_MS=30000

# Worker concurrency
# Initial defaults; editable in Global Settings → Workers & Performance.
# SEM_LIMIT = pages captured at once per worker, shared by all running tasks
# and re-captures (size it to the browser host: ~2 per vCPU).
# Note: TASK_JOB_TIMEOUT_SECONDS is also the ARQ hard ceiling set at worker
# boot — raising the UI value above this still requires a worker restart.
# Time a task spends waiting for a free capture slot counts towards it.
SEM_LIMIT=5
TASK_JOB_TIMEOUT_SECONDS=7200
# Capture all viewports of a URL in one shared browser context (warm HTTP cache;
# cookies/localStorage carry over between those viewports). Retries always use
# a fresh isolated context.
REUSE_BROWSER_CONTEXT=true
# .env-only: max tasks/re-captures a worker runs at once (ARQ max_jobs).
# WORKER_MAX_JOBS=10

# Development host ports
DEV_API_PORT=15173
DEV_FRONTEND_PORT=15173
DEV_DB_PORT=15432
DEV_REDIS_PORT=16379

# Production host ports
PROD_HTTP_PORT=80
